+            ->header('Cache-Control', 'public, max-age=120, s-maxage=300')
+            ->header('X-Robots-Tag', 'noindex, follow');
+    }
+
+    public function publicEventShareImage(string $slug, EventSocialPreviewService $preview)
+    {
+        $event = $preview->findPublicEvent($slug);
+        $path = $preview->previewImagePath($event);
+
+        if (! $path) {
+            return redirect()->away($preview->sourceImageUrl($event));
+        }
+
+        return response()->file($path, [
+            'Content-Type' => 'image/jpeg',
+            'Cache-Control' => 'public, max-age=86400, immutable',
+        ]);
+    }
