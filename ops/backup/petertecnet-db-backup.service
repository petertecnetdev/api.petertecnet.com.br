[Unit]
Description=Peter Tecnet encrypted database backup
Documentation=https://github.com/petertecnetdev/api.petertecnet.com.br/tree/main/ops/backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/petertecnet-db-backup daily
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
